{
  "templates": [
    {
      "name": "lumen-enterprise-homepage",
      "urls": [
        "https://www.lumen.com/en-us/home.html"
      ],
      "description": "Lumen enterprise homepage with hero banner, customer stats, tabbed content, industry selector, solutions cards, partner logos, industry cards, and support section",
      "blocks": [
        {
          "name": "hero-enterprise",
          "instances": [
            "div.herobanner.teaser"
          ]
        },
        {
          "name": "cards-stats",
          "instances": [
            "div.teasercontainer.teaser:has(.teaser-stat-tiles)"
          ]
        },
        {
          "name": "tabs-numbered",
          "instances": [
            "div.stackedContent"
          ]
        },
        {
          "name": "columns-industry",
          "instances": [
            "div.industrySelectorBlock"
          ]
        },
        {
          "name": "cards-solutions",
          "instances": [
            "div.teasercontainer.teaser:has(.teaser-cards-block)"
          ]
        },
        {
          "name": "carousel-logos",
          "instances": [
            "div.partnerstory"
          ]
        },
        {
          "name": "cards-industry",
          "instances": [
            "div.teasercontainer.teaser:has(.teaser-staggered-cards)"
          ]
        },
        {
          "name": "cards-support",
          "instances": [
            "div.teasercontainer.teaser:has(.teaser-with-cards)"
          ]
        }
      ]
    }
  ]
}
